@@ -0,0 +1,204 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser: columns-contact
+ * Base block: columns
+ * Source: https://www.spvbstemple.org/contact
+ * Description: Two-column layout. Left column contains stacked contact info cards
+ *   (Address, Phone Numbers with Additional Contacts, Email, WhatsApp).
+ *   Right column contains a Location card with temple background image,
+ *   map pin icon, "Find us on Google Maps" text, and "Get Directions" CTA.
+ *   Single row with 2 columns matching the columns block library pattern.
+ * Generated: 2026-05-15
+ */
+export default function parse(element, { document }) {
+  // The element is the 2-column grid container:
+  // div.grid.grid-cols-1.md:grid-cols-2.gap-12.max-w-6xl.mx-auto
+  // First child: div.space-y-8 (left column with contact cards)
+  // Second child: div with location card (right column)
+
+  const gridChildren = element.querySelectorAll(':scope > div');
+
+  // Left column: contact details (div.space-y-8 with multiple .rounded-xl cards)
+  const leftCol = gridChildren[0] || null;
+  // Right column: location card (div.rounded-xl with background image)
+  const rightCol = gridChildren[1] || null;
+
+  // === Build Left Column Content ===
+  const col1Content = [];
+
+  if (leftCol) {
+    // Address card
+    const addressCard = leftCol.querySelector('div.bg-white.rounded-xl');
+    if (addressCard) {
+      const addressHeading = addressCard.querySelector('h2');
+      if (addressHeading) col1Content.push(addressHeading);
+
+      const addressEl = addressCard.querySelector('address');
+      if (addressEl) {
+        const addressPs = addressEl.querySelectorAll('p');
+        addressPs.forEach((p) => {
+          const newP = document.createElement('p');
+          newP.textContent = p.textContent.trim();
+          col1Content.push(newP);
+        });
+      }
+    }
+
+    // Phone Numbers card - second .bg-white.rounded-xl card
+    const contactCards = leftCol.querySelectorAll(':scope > div.bg-white.rounded-xl');
+
+    if (contactCards.length >= 2) {
+      const phoneCard = contactCards[1];
+      const phoneHeading = phoneCard.querySelector('h2');
+      if (phoneHeading) col1Content.push(phoneHeading);
+
+      // Primary and secondary phone numbers
+      const phoneParagraphs = phoneCard.querySelectorAll(':scope > div > div > div > p');
+      const phoneLinks = phoneCard.querySelectorAll('a[href^="tel:"]');
+
+      // Get primary/secondary phones from the top-level section
+      const topPhoneSection = phoneCard.querySelector('div.space-y-4 > div');
+      if (topPhoneSection) {
+        const phonePs = topPhoneSection.querySelectorAll(':scope > p');
+        phonePs.forEach((p) => {
+          const newP = document.createElement('p');
+          const link = p.querySelector('a[href^="tel:"]');
+          if (link) {
+            newP.textContent = p.textContent.trim();
+            const a = document.createElement('a');
+            a.href = link.getAttribute('href');
+            a.textContent = link.textContent.trim();
+            col1Content.push(newP);
+          } else {
+            newP.textContent = p.textContent.trim();
+            col1Content.push(newP);
+          }
+        });
+      }
+
+      // Additional Contacts sub-heading
+      const additionalHeading = phoneCard.querySelector('h3');
+      if (additionalHeading) col1Content.push(additionalHeading);
+
+      // Additional contacts list
+      const additionalContacts = phoneCard.querySelectorAll('div.space-y-6 > div.space-y-2');
+      additionalContacts.forEach((contactDiv) => {
+        const name = contactDiv.querySelector('p.font-medium');
+        const role = contactDiv.querySelector('p[class*="text-sm"]');
+        const contactPhoneLinks = contactDiv.querySelectorAll('a[href^="tel:"]');
+        const whatsappLink = contactDiv.querySelector('a[href*="wa.me"]');
+
+        if (name) {
+          const p = document.createElement('p');
+          const strong = document.createElement('strong');
+          strong.textContent = name.textContent.trim();
+          p.appendChild(strong);
+          if (role && role.textContent.trim()) {
+            p.appendChild(document.createTextNode(' - ' + role.textContent.trim()));
+          }
+          col1Content.push(p);
+        }
+
+        contactPhoneLinks.forEach((link) => {
+          const a = document.createElement('a');
+          a.href = link.getAttribute('href');
+          a.textContent = link.textContent.trim();
+          col1Content.push(a);
+        });
+
+        if (whatsappLink) {
+          const a = document.createElement('a');
+          a.href = whatsappLink.getAttribute('href');
+          a.textContent = whatsappLink.textContent.trim() || 'WhatsApp';
+          col1Content.push(a);
+        }
+      });
+    }
+
+    // Email card
+    if (contactCards.length >= 3) {
+      const emailCard = contactCards[2];
+      const emailHeading = emailCard.querySelector('h2');
+      if (emailHeading) col1Content.push(emailHeading);
+
+      const emailLink = emailCard.querySelector('a[href^="mailto:"]');
+      if (emailLink) {
+        const a = document.createElement('a');
+        a.href = emailLink.getAttribute('href');
+        a.textContent = emailLink.textContent.trim();
+        col1Content.push(a);
+      }
+    }
+
+    // WhatsApp card
+    if (contactCards.length >= 4) {
+      const whatsappCard = contactCards[3];
+      const whatsappHeading = whatsappCard.querySelector('h2');
+      if (whatsappHeading) col1Content.push(whatsappHeading);
+
+      const whatsappLink = whatsappCard.querySelector('a[href*="wa.me"]');
+      if (whatsappLink) {
+        const a = document.createElement('a');
+        a.href = whatsappLink.getAttribute('href');
+        a.textContent = whatsappLink.textContent.trim();
+        col1Content.push(a);
+      }
+    }
+  }
+
+  // === Build Right Column Content ===
+  const col2Content = [];
+
+  if (rightCol) {
+    // Location heading
+    const locationHeading = rightCol.querySelector('h2');
+    if (locationHeading) col2Content.push(locationHeading);
+
+    // Temple background image
+    const bgImage = rightCol.querySelector(
+      'div[class*="bg-cover"] img, div[class*="absolute"][class*="inset-0"] img'
+    );
+    if (bgImage) {
+      const img = document.createElement('img');
+      img.src = bgImage.getAttribute('src') || '';
+      img.alt = bgImage.getAttribute('alt') || 'Temple location';
+      col2Content.push(img);
+    }
+
+    // "Find us on Google Maps" text
+    const mapText = rightCol.querySelector('p[class*="font-medium"]');
+    if (mapText) {
+      const p = document.createElement('p');
+      p.textContent = mapText.textContent.trim();
+      col2Content.push(p);
+    }
+
+    // "Get Directions" CTA link
+    const directionsLink = rightCol.querySelector(
+      'a[href*="google.com/maps"], a[href*="maps.google"]'
+    );
+    if (directionsLink) {
+      const a = document.createElement('a');
+      a.href = directionsLink.getAttribute('href');
+      // Get the visible text, skipping inline icon images
+      const textNodes = [];
+      directionsLink.childNodes.forEach((node) => {
+        if (node.nodeType === 3) {
+          textNodes.push(node.textContent.trim());
+        } else if (node.tagName !== 'IMG') {
+          textNodes.push(node.textContent.trim());
+        }
+      });
+      a.textContent = textNodes.filter(Boolean).join(' ') || 'Get Directions';
+      col2Content.push(a);
+    }
+  }
+
+  // Build cells: single row with 2 columns matching the columns block library pattern
+  const cells = [[col1Content, col2Content]];
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'columns-contact', cells });
+  element.replaceWith(block);
+}
diff --git a/tools/importer/parsers/columns-donate.js b/tools/importer/parsers/columns-donate.js
new file mode 100644
index 0000000..9a3196a
--- /dev/null
+++ b/tools/importer/parsers/columns-donate.js
@@ -0,0 +1,170 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser: columns-donate
+ * Base block: columns
+ * Source: https://www.spvbstemple.org/donate
+ * Description: 2-column layout with bank transfer / donation details on the left
+ *   and temple development info with CTAs on the right. Extracts all semantic
+ *   content (headings, paragraphs, lists, links) from each column side.
+ * Generated: 2026-05-15
+ */
+export default function parse(element, { document }) {
+  // The element is the 2-column grid container: div.grid.lg:grid-cols-2
+  // It has two direct child divs (div.space-y-8), one per column.
+  const columnDivs = element.querySelectorAll(':scope > div');
+
+  if (columnDivs.length < 2) {
+    // Fallback: if structure doesn't match, wrap all content in a single column
+    const allContent = [];
+    const heading = element.querySelector('h2, h3');
+    if (heading) allContent.push(heading);
+    const paras = Array.from(element.querySelectorAll('p'));
+    allContent.push(...paras);
+    const cells = [allContent];
+    const block = WebImporter.Blocks.createBlock(document, { name: 'columns-donate', cells });
+    element.replaceWith(block);
+    return;
+  }
+
+  // --- LEFT COLUMN (Donation / Bank Transfer details) ---
+  // The left div.space-y-8 may contain multiple cards. The donation card is the
+  // FIRST bg-white card (with "Make a Donation" heading). The second card
+  // ("Seva & Donation Categories") is handled by the cards-seva parser separately.
+  const leftDiv = columnDivs[0];
+  const leftContent = [];
+
+  // Target only the first white card in the left column (donation info card)
+  const donationCard = leftDiv.querySelector(':scope > .bg-white, :scope > div:first-child');
+
+  if (donationCard) {
+    // H2: "Make a Donation"
+    const leftHeading = donationCard.querySelector('h2');
+    if (leftHeading) leftContent.push(leftHeading);
+
+    // Description paragraph directly under the card heading
+    const introParas = donationCard.querySelectorAll(':scope > p');
+    introParas.forEach((p) => leftContent.push(p));
+
+    // H3: "Bank Transfer Details" inside the bg-temple-light section
+    const bankSection = donationCard.querySelector('[class*="bg-temple-light"][class*="rounded"]');
+    if (bankSection) {
+      const bankHeading = bankSection.querySelector('h3');
+      if (bankHeading) leftContent.push(bankHeading);
+
+      // All bank detail items live inside div.space-y-6 as direct children.
+      // Three are div.flex.justify-between (with div.flex-grow > label + value),
+      // and one is a plain div with direct p children (Bank & Branch).
+      const detailContainer = bankSection.querySelector('.space-y-6');
+      if (detailContainer) {
+        const detailDivs = detailContainer.querySelectorAll(':scope > div');
+        detailDivs.forEach((div) => {
+          let label = null;
+          let value = null;
+
+          // Check for flex-grow wrapper (Account Number, IFSC, Beneficiary)
+          const flexGrow = div.querySelector('.flex-grow');
+          if (flexGrow) {
+            label = flexGrow.querySelector('.text-sm, p:first-child');
+            value = flexGrow.querySelector('.text-xl, .text-red-600, p:last-child');
+          } else {
+            // Plain div (Bank & Branch)
+            label = div.querySelector('.text-sm, p:first-child');
+            value = div.querySelector('.text-xl, .text-red-600, p:last-child');
+          }
+
+          if (label && value && label !== value) {
+            const combined = document.createElement('p');
+            const strong = document.createElement('strong');
+            strong.textContent = label.textContent.trim();
+            combined.appendChild(strong);
+            combined.appendChild(document.createTextNode(': ' + value.textContent.trim()));
+            leftContent.push(combined);
+          }
+        });
+      }
+    }
+
+    // "- OR -" separator text
+    const orSeparator = donationCard.querySelector('.text-center > p');
+    if (orSeparator && orSeparator.textContent.trim().includes('OR')) {
+      const sep = document.createElement('p');
+      sep.textContent = orSeparator.textContent.trim();
+      leftContent.push(sep);
+    }
+
+    // WhatsApp CTA link (first one in donation card, not in seva cards)
+    const whatsappLink = donationCard.querySelector('a[href*="wa.me"]');
+    if (whatsappLink) {
+      const link = document.createElement('a');
+      link.href = whatsappLink.getAttribute('href');
+      const linkText = whatsappLink.textContent.trim() || 'Contact via WhatsApp';
+      link.textContent = linkText;
+      const linkPara = document.createElement('p');
+      linkPara.appendChild(link);
+      leftContent.push(linkPara);
+    }
+
+    // Confirmation instruction paragraphs (after WhatsApp link)
+    const instructionContainer = donationCard.querySelector('.text-sm.text-temple-text.text-center, [class*="text-sm"][class*="text-center"][class*="space-y"]');
+    if (instructionContainer) {
+      const instructionParas = instructionContainer.querySelectorAll('p');
+      instructionParas.forEach((p) => {
+        leftContent.push(p);
+      });
+    }
+  }
+
+  // --- RIGHT COLUMN (Temple Development info) ---
+  const rightDiv = columnDivs[1];
+  const rightContent = [];
+
+  // H2: "Temple Development Through Your Support"
+  const rightHeading = rightDiv.querySelector('h2');
+  if (rightHeading) rightContent.push(rightHeading);
+
+  // Prose content area (div.prose) contains sub-section divs
+  const proseArea = rightDiv.querySelector('.prose, [class*="prose"]');
+  const contentArea = proseArea || rightDiv;
+
+  // Recursively extract semantic elements (h3, p, ul, a) from the prose area,
+  // preserving document order. This avoids complex nested-div logic.
+  const processNode = (container) => {
+    const children = container.children;
+    for (let i = 0; i < children.length; i++) {
+      const child = children[i];
+      const tag = child.tagName;
+
+      if (tag === 'H3') {
+        rightContent.push(child);
+      } else if (tag === 'P') {
+        rightContent.push(child);
+      } else if (tag === 'UL' || tag === 'OL') {
+        rightContent.push(child);
+      } else if (tag === 'A') {
+        // CTA link (e.g., "Support Kalyana Mandapam Project", "View Completed Projects")
+        const linkText = child.textContent.trim();
+        if (linkText) {
+          const link = document.createElement('a');
+          link.href = child.getAttribute('href') || '#';
+          link.textContent = linkText;
+          const linkPara = document.createElement('p');
+          linkPara.appendChild(link);
+          rightContent.push(linkPara);
+        }
+      } else if (tag === 'DIV') {
+        // Recurse into wrapper divs (div.mb-8, div.flex, div.border-t, etc.)
+        processNode(child);
+      }
+    }
+  };
+
+  processNode(contentArea);
+
+  // Build cells: single row with 2 columns
+  const cells = [[leftContent, rightContent]];
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'columns-donate', cells });
+  element.replaceWith(block);
+}
diff --git a/tools/importer/parsers/columns-video.js b/tools/importer/parsers/columns-video.js
new file mode 100644
index 0000000..89461b5
--- /dev/null
+++ b/tools/importer/parsers/columns-video.js
@@ -0,0 +1,120 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for columns-video variant.
+ * Base block: columns
+ * Source: https://www.spvbstemple.org/projects
+ * Generated: 2026-05-15
+ *
+ * Extracts 3 YouTube video embeds displayed side by side in a columns layout.
+ * Each column contains a YouTube link and a title caption.
+ *
+ * Source structure (validated against cleaned.html lines 270-295):
+ *   <section class="my-12 bg-temple-light rounded-xl shadow-lg p-6 text-center">
+ *     <h2>See Our Temple in Action</h2>
+ *     <p>Watch these short videos...</p>
+ *     <div class="flex flex-col md:flex-row gap-6 justify-center">
+ *       <a href="https://youtu.be/{id}" class="flex-1">
+ *         <div class="aspect-video ...">
+ *           <iframe src="https://www.youtube.com/embed/{id}" title="..."></iframe>
+ *         </div>
+ *         <div class="mt-2 font-semibold text-temple-primary">{title}</div>
+ *       </a>
+ *       ... (3 total)
+ *     </div>
+ *   </section>
+ *
+ * Target structure (Columns block):
+ *   1 row with 3 columns. Each column cell contains:
+ *     - A YouTube link (anchor element)
+ *     - A title paragraph
+ *
+ * Validated selectors:
+ *   - Video container: div.flex (contains the 3 <a> children)
+ *   - Video links: a.flex-1 (each wraps an iframe + title)
+ *   - Iframe: iframe[src*="youtube.com/embed"] (inside each <a>)
+ *   - Title: div.mt-2, div.font-semibold (caption below each video)
+ */
+export default function parse(element, { document }) {
+  // Find all video link containers — each <a class="flex-1"> wraps one video
+  // Validated: 3 anchor elements with class "flex-1" inside the flex container
+  const videoContainer = element.querySelector('div.flex');
+  const videoLinks = videoContainer
+    ? videoContainer.querySelectorAll(':scope > a')
+    : element.querySelectorAll('a.flex-1, a[href*="youtu"]');
+
+  // Build one cell per video column
+  const row = [];
+
+  videoLinks.forEach((anchor) => {
+    const cellContent = [];
+
+    // Extract YouTube URL from the <a> href or from the nested iframe src
+    // Validated: href uses youtu.be short URL format, iframe uses youtube.com/embed format
+    let videoUrl = '';
+    const href = anchor.getAttribute('href') || '';
+
+    if (href && (href.includes('youtu.be') || href.includes('youtube.com'))) {
+      // Use the href directly — convert short URL to standard watch URL if needed
+      const shortMatch = href.match(/youtu\.be\/([^?&#]+)/);
+      const watchMatch = href.match(/youtube\.com\/watch\?v=([^&#]+)/);
+      const embedMatch = href.match(/youtube\.com\/embed\/([^?&#]+)/);
+
+      if (shortMatch) {
+        videoUrl = `https://www.youtube.com/watch?v=${shortMatch[1]}`;
+      } else if (watchMatch) {
+        videoUrl = href;
+      } else if (embedMatch) {
+        videoUrl = `https://www.youtube.com/watch?v=${embedMatch[1]}`;
+      } else {
+        videoUrl = href;
+      }
+    } else {
+      // Fallback: extract from nested iframe src
+      const iframe = anchor.querySelector('iframe[src*="youtube.com/embed"], iframe[src*="youtu.be"]');
+      if (iframe) {
+        const src = iframe.getAttribute('src') || '';
+        const iframeMatch = src.match(/youtube\.com\/embed\/([^?&#]+)/);
+        if (iframeMatch) {
+          videoUrl = `https://www.youtube.com/watch?v=${iframeMatch[1]}`;
+        } else {
+          videoUrl = src;
+        }
+      }
+    }
+
+    // Create a link element for the YouTube URL
+    if (videoUrl) {
+      const link = document.createElement('a');
+      link.href = videoUrl;
+      link.textContent = videoUrl;
+      cellContent.push(link);
+    }
+
+    // Extract the title text from the caption div below the iframe
+    // Validated: div.mt-2.font-semibold.text-temple-primary contains the title
+    const titleDiv = anchor.querySelector('div.mt-2, div.font-semibold, div[class*="font-semibold"]');
+    if (titleDiv) {
+      const titleP = document.createElement('p');
+      titleP.textContent = titleDiv.textContent.trim();
+      cellContent.push(titleP);
+    } else {
+      // Fallback: use iframe title attribute
+      const iframe = anchor.querySelector('iframe');
+      if (iframe && iframe.getAttribute('title')) {
+        const titleP = document.createElement('p');
+        titleP.textContent = iframe.getAttribute('title');
+        cellContent.push(titleP);
+      }
+    }
+
+    row.push(cellContent);
+  });
+
+  // Build cells: single row with N columns (expected: 3)
+  const cells = [row];
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'columns-video', cells });
+  element.replaceWith(block);
+}
