@@ -0,0 +1,156 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser: cards-seva
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/donate
+ * Description: Grid of seva/donation category cards with icons, pricing (INR/USD),
+ *   descriptions, and WhatsApp CTA links. Includes 3 seva offering cards,
+ *   1 annual events card (with a 2x2 event grid), and 1 contact-for-bookings card.
+ *   Each card row: col1 = icon, col2 = heading + price + description + CTA.
+ * Generated: 2026-05-15
+ */
+export default function parse(element, { document }) {
+  // The element is the container wrapping the "Seva & Donation Categories" section.
+  // Cards are in a grid: div.grid inside the container, each card is a direct child
+  // div with .rounded-xl.shadow-decorative.border or .rounded-xl.shadow-decorative
+  // The last two cards (Annual Events, Contact for Seva Bookings) are siblings after the grid.
+  const allCards = element.querySelectorAll(
+    '.grid > div[class*="rounded-xl"][class*="shadow-decorative"], div.space-y-8 > div[class*="rounded-xl"][class*="shadow-decorative"]'
+  );
+
+  // Fallback: if the above selector doesn't match, try broader selection
+  const cardElements = allCards.length > 0
+    ? allCards
+    : element.querySelectorAll('div[class*="rounded-xl"][class*="border-temple-divider"], div[class*="rounded-xl"][class*="shadow-decorative"] > div[class*="rounded-xl"]');
+
+  // If still no cards, try selecting all direct card-like containers
+  const cards = cardElements.length > 0
+    ? cardElements
+    : element.querySelectorAll('div[class*="rounded-xl"][class*="p-6"]');
+
+  const cells = [];
+
+  cards.forEach((card) => {
+    // Extract icon image from the icon container
+    const iconContainer = card.querySelector(
+      'div[class*="text-3xl"][class*="text-temple-gold"], div[class*="text-temple-gold"][class*="flex"][class*="justify-center"]'
+    );
+    const iconImg = iconContainer ? iconContainer.querySelector('img') : null;
+
+    // Extract heading: h3 element
+    const heading = card.querySelector('h3');
+
+    // Extract price paragraph: contains spans with INR (text-temple-primary) and USD (text-green-600)
+    const pricePara = card.querySelector('p[class*="font-sanskrit"]');
+
+    // Extract description paragraph: text-temple-text paragraph
+    const description = card.querySelector('p[class*="text-temple-text"]');
+
+    // Extract CTA links (WhatsApp contact links, phone links)
+    const ctaLinks = Array.from(card.querySelectorAll('a[href*="wa.me"], a[href*="tel:"]'));
+
+    // Handle the Annual Events special card: has a grid-cols-2 with event names
+    const eventsGrid = card.querySelector('div[class*="grid-cols-2"]');
+    const eventNames = eventsGrid
+      ? Array.from(eventsGrid.querySelectorAll('p')).map((p) => p.textContent.trim())
+      : [];
+
+    // Handle the Contact for Seva Bookings special card: has priest name and phone/WhatsApp
+    const priestName = card.querySelector('p[class*="font-medium"][class*="text-temple-text"]');
+
+    // Build icon column (col1)
+    const col1 = [];
+    let iconName = '';
+
+    if (iconImg) {
+      const src = iconImg.getAttribute('src') || '';
+      if (src.startsWith('data:image/svg+xml;base64,')) {
+        try {
+          const svgText = atob(src.replace('data:image/svg+xml;base64,', ''));
+          const match = svgText.match(/data-icon="([^"]+)"/);
+          if (match) iconName = match[1];
+        } catch (e) { /* ignore decode errors */ }
+      }
+    }
+
+    if (iconName) {
+      const img = document.createElement('img');
+      img.src = `/icons/${iconName}.svg`;
+      img.alt = iconName.replace(/-/g, ' ');
+      col1.push(img);
+    } else {
+      // Fallback: derive icon name from heading text
+      const fallbackName = heading
+        ? heading.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
+        : 'icon';
+      const img = document.createElement('img');
+      img.src = `/icons/${fallbackName}.svg`;
+      img.alt = heading ? heading.textContent.trim() : 'icon';
+      col1.push(img);
+    }
+
+    // Build content column (col2)
+    const col2 = [];
+
+    if (heading) {
+      col2.push(heading);
+    }
+
+    // Add price info if present (seva offering cards)
+    if (pricePara) {
+      col2.push(pricePara);
+    }
+
+    // Add description if present
+    if (description) {
+      col2.push(description);
+    }
+
+    // Add event names as a list (Annual Events card)
+    if (eventNames.length > 0) {
+      const ul = document.createElement('ul');
+      eventNames.forEach((name) => {
+        const li = document.createElement('li');
+        li.textContent = name;
+        ul.appendChild(li);
+      });
+      col2.push(ul);
+    }
+
+    // Add priest/contact info (Contact for Seva Bookings card)
+    if (priestName) {
+      const titleP = card.querySelector('p[class*="font-sanskrit"][class*="text-lg"]');
+      if (titleP) {
+        const p = document.createElement('p');
+        p.textContent = titleP.textContent.trim();
+        col2.push(p);
+      }
+      col2.push(priestName);
+    }
+
+    // Add CTA links
+    ctaLinks.forEach((link) => {
+      const a = document.createElement('a');
+      a.href = link.href || link.getAttribute('href');
+      // Extract text content, skipping nested img elements
+      const textSpan = link.querySelector('span');
+      a.textContent = textSpan ? textSpan.textContent.trim() : link.textContent.trim();
+      col2.push(a);
+    });
+
+    // Only add the row if we have content
+    if (col2.length > 0) {
+      cells.push([col1, col2]);
+    }
+  });
+
+  // If no cards were extracted, do not create an empty block
+  if (cells.length === 0) {
+    return;
+  }
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-seva', cells });
+  element.replaceWith(block);
+}
