+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for accordion-faq
+ * Base block: accordion
+ * Source: https://www.spvbstemple.org/
+ * Selector: section.faq-section
+ * Generated: 2026-05-15
+ *
+ * Extracts FAQ items from the FAQ section. The source site is a React SPA
+ * where accordion items lazy-load via IntersectionObserver. To handle headless
+ * browser environments where lazy content may not render, this parser falls back
+ * to extracting FAQ data from the page's JSON-LD FAQPage structured data.
+ *
+ * Outputs one row per FAQ item: col1=question title, col2=answer content.
+ */
+export default function parse(element, { document }) {
+  const cells = [];
+
+  // Strategy 1: Try to extract from live DOM (buttons + answer panels)
+  const buttons = element.querySelectorAll(
+    'button[id^="faq-header-"], button[aria-controls^="faq-panel-"]',
+  );
+
+  if (buttons.length > 0) {
+    buttons.forEach((button) => {
+      const item = button.closest('div.group')
+        || button.closest('div[class*="border"]')
+        || button.parentElement;
+
+      // Get clean question text, excluding the arrow indicator span
+      const buttonClone = button.cloneNode(true);
+      const arrowSpan = buttonClone.querySelector('span');
+      if (arrowSpan) arrowSpan.remove();
+      const questionTitle = buttonClone.textContent.trim();
+      if (!questionTitle) return;
+
+      const questionEl = document.createElement('h3');
+      questionEl.textContent = questionTitle;
+
+      // Look for answer panel (conditionally rendered by React)
+      let answerPanel = null;
+      const panelId = button.getAttribute('aria-controls');
+      if (panelId) answerPanel = document.getElementById(panelId);
+      if (!answerPanel && item) answerPanel = item.querySelector('div[role="region"]');
+      if (!answerPanel && item) {
+        const children = Array.from(item.children);
+        for (const child of children) {
+          if (child !== button && child.tagName === 'DIV') {
+            answerPanel = child;
+            break;
+          }
+        }
+      }
+
+      let answerContent;
+      if (answerPanel && answerPanel.textContent.trim()) {
+        answerContent = answerPanel.cloneNode(true);
+      } else {
+        answerContent = document.createElement('p');
+        answerContent.textContent = '';
+      }
+
+      cells.push([questionEl, answerContent]);
+    });
+  }
+
+  // Strategy 2: Fall back to JSON-LD FAQPage structured data
+  // This handles headless browsers where lazy-loaded accordion items may not render
+  if (cells.length === 0) {
+    const ldScripts = document.querySelectorAll('script[type="application/ld+json"]');
+    let faqData = null;
+
+    for (const script of ldScripts) {
+      try {
+        const data = JSON.parse(script.textContent);
+        if (data['@type'] === 'FAQPage' && Array.isArray(data.mainEntity)) {
+          faqData = data;
+          break;
+        }
+      } catch (e) {
+        // Skip malformed JSON-LD
+      }
+    }
+
+    if (faqData && faqData.mainEntity) {
+      faqData.mainEntity.forEach((item) => {
+        const questionText = item.name || '';
+        const answerText = (item.acceptedAnswer && item.acceptedAnswer.text) || '';
+
+        if (!questionText) return;
+
+        const questionEl = document.createElement('h3');
+        questionEl.textContent = questionText;
+
+        const answerEl = document.createElement('p');
+        answerEl.textContent = answerText;
+
+        cells.push([questionEl, answerEl]);
+      });
+    }
+  }
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'accordion-faq', cells });
+  element.replaceWith(block);
+}
