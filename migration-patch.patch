--- /dev/null
+++ b/tools/importer/parsers/embed-video.js
@@ -0,0 +1,53 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for embed-video variant.
+ * Base block: embed
+ * Source: https://www.spvbstemple.org/gallery
+ * Generated: 2026-05-15
+ *
+ * Extracts a YouTube embedded video from an iframe element within the
+ * "Featured Video" section. Converts the embed URL to a standard YouTube
+ * watch URL and creates an Embed block with the video link.
+ *
+ * Source structure (validated against cleaned.html lines 68-73):
+ *   <div class="aspect-video w-full rounded-xl ...">
+ *     <div class="w-full h-full">
+ *       <iframe src="https://www.youtube.com/embed/{videoId}?autoplay=0" title="...">
+ *     </div>
+ *   </div>
+ */
+export default function parse(element, { document }) {
+  // Find the iframe — the primary source of the YouTube URL
+  // Validated selector: iframe with YouTube embed src inside .aspect-video container
+  const iframe = element.querySelector('iframe[src*="youtube.com/embed"]')
+    || element.querySelector('iframe[src*="youtu.be"]')
+    || element.querySelector('iframe');
+
+  const cells = [];
+
+  if (iframe) {
+    const embedSrc = iframe.getAttribute('src') || '';
+
+    // Convert YouTube embed URL to standard watch URL
+    // e.g. https://www.youtube.com/embed/TXk6fjDZw0c?autoplay=0
+    //   -> https://www.youtube.com/watch?v=TXk6fjDZw0c
+    let videoUrl = embedSrc;
+    const embedMatch = embedSrc.match(/youtube\.com\/embed\/([^?&#]+)/);
+    if (embedMatch) {
+      videoUrl = `https://www.youtube.com/watch?v=${embedMatch[1]}`;
+    }
+
+    // Create an anchor element with the YouTube URL
+    // AEM EDS Embed block expects a link in the cell
+    const link = document.createElement('a');
+    link.href = videoUrl;
+    link.textContent = videoUrl;
+
+    cells.push([link]);
+  }
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'embed-video', cells });
+  element.replaceWith(block);
+}
