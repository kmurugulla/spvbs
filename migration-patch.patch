@@ -0,0 +1,70 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for hero-about variant.
+ * Base block: hero
+ * Source: https://www.spvbstemple.org/about
+ * Generated: 2026-05-15
+ *
+ * Extracts a dark hero section with a circular portrait image,
+ * a main heading, and a subtitle from the about page.
+ *
+ * Source structure:
+ *   div.bg-temple-dark (hero container)
+ *     div.absolute.inset-0 > img          — decorative background pattern (skipped)
+ *     div.container
+ *       div.w-48.h-48 > img               — portrait image (rounded, bordered)
+ *       h1                                 — main heading (gold text)
+ *       p.text-2xl                         — subtitle text
+ *
+ * Target table (hero block):
+ *   Row 1: portrait image
+ *   Row 2: heading + subtitle
+ */
+export default function parse(element, { document }) {
+  // Extract portrait image — the visible content image (not the background pattern)
+  // The background pattern is inside div.absolute.inset-0 and should be skipped
+  const bgPatternContainer = element.querySelector(':scope > div.absolute, :scope > .absolute.inset-0');
+  const contentContainer = element.querySelector('.container, .text-center.relative');
+
+  // Portrait image: inside a sized wrapper div, has meaningful alt text
+  let portraitImg = null;
+  if (contentContainer) {
+    portraitImg = contentContainer.querySelector('img[alt], img.rounded-full, img.object-cover');
+  }
+  // Fallback: find any non-background-pattern image
+  if (!portraitImg) {
+    const allImages = element.querySelectorAll('img');
+    allImages.forEach((img) => {
+      if (!portraitImg && img.closest('.absolute.inset-0') === null) {
+        portraitImg = img;
+      }
+    });
+  }
+
+  // Extract heading — h1 is primary, fall back to h2
+  const heading = element.querySelector('h1, h2, [class*="heading"]');
+
+  // Extract subtitle — the paragraph following the heading
+  const subtitle = element.querySelector('p.text-2xl, p.font-sanskrit, .container p');
+
+  // Build cells array matching hero block table structure
+  const cells = [];
+
+  // Row 1: portrait image
+  if (portraitImg) {
+    cells.push([portraitImg]);
+  }
+
+  // Row 2: heading + subtitle combined in one cell
+  const contentCell = [];
+  if (heading) contentCell.push(heading);
+  if (subtitle) contentCell.push(subtitle);
+  if (contentCell.length > 0) {
+    cells.push(contentCell);
+  }
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'hero-about', cells });
+  element.replaceWith(block);
+}
