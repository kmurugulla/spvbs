@@ -0,0 +1,84 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for cards-event variant.
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/
+ * Generated: 2026-05-15
+ *
+ * Extracts a grid of event cards. Each card has:
+ *   - An icon image (SVG in a centered container)
+ *   - A gold h3 heading (event name)
+ *   - A schedule/frequency line (p.font-sanskrit)
+ *   - A description paragraph or link
+ *
+ * Target structure (from block library):
+ *   2 columns per row: col1 = icon image, col2 = heading + schedule + description
+ *   One row per card.
+ *
+ * Validated selectors against source.html:
+ *   - Cards: element > div.relative.bg-temple-overlay (direct child divs of the grid)
+ *   - Icon: div.text-temple-gold img
+ *   - Heading: h3.text-temple-gold
+ *   - Schedule: p.font-sanskrit
+ *   - Description: p.text-white\/80, a.text-white\/80 (third card uses an anchor)
+ */
+export default function parse(element, { document }) {
+  // Select all card containers — direct children of the grid element
+  const cards = element.querySelectorAll(':scope > div');
+
+  const cells = [];
+
+  cards.forEach((card) => {
+    // Col 1: Icon image
+    // In the live DOM, icons may be <img> with base64 SVG src, or inline <svg> elements.
+    // Look for img first, then svg inside the icon container.
+    const iconContainer = card.querySelector('div.text-temple-gold, div.flex.justify-center');
+    let iconEl = null;
+    if (iconContainer) {
+      const img = iconContainer.querySelector('img');
+      const svg = iconContainer.querySelector('svg');
+      if (img) {
+        iconEl = img;
+      } else if (svg) {
+        // Convert inline SVG to an img element so it renders in markdown
+        const svgData = new XMLSerializer().serializeToString(svg);
+        const dataUri = `data:image/svg+xml;base64,${btoa(svgData)}`;
+        const imgFromSvg = document.createElement('img');
+        imgFromSvg.src = dataUri;
+        imgFromSvg.alt = '';
+        iconEl = imgFromSvg;
+      }
+    }
+
+    // Col 2: Heading + schedule + description
+    const heading = card.querySelector('h3');
+    const schedule = card.querySelector('p.font-sanskrit, p[class*="font-sanskrit"]');
+
+    // Description can be a <p> or an <a> element (third card uses an anchor for its description)
+    // Get all text-bearing children after schedule, excluding heading and schedule
+    const allParagraphs = card.querySelectorAll(':scope > p, :scope > a');
+    let description = null;
+    for (const el of allParagraphs) {
+      if (el !== heading && el !== schedule) {
+        // Pick the last matching element (the description comes after schedule)
+        description = el;
+      }
+    }
+
+    // Build col1
+    const col1 = iconEl || '';
+
+    // Build col2 — heading, schedule line, description
+    const col2 = [];
+    if (heading) col2.push(heading);
+    if (schedule) col2.push(schedule);
+    if (description) col2.push(description);
+
+    cells.push([col1, col2]);
+  });
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-event', cells });
+  element.replaceWith(block);
+}
