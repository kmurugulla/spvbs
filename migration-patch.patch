@@ -0,0 +1,39 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for carousel-hero variant.
+ * Base block: carousel
+ * Source: https://www.spvbstemple.org/
+ * Generated: 2026-05-15
+ *
+ * Extracts hero carousel slide images from rotating image divs.
+ * Each slide becomes one row with its image.
+ * Navigation arrows and dot indicators are decoration — not imported.
+ */
+export default function parse(element, { document }) {
+  // Each slide is a div.absolute.inset-0 containing an img
+  // These are direct children of the carousel container
+  const slideDivs = element.querySelectorAll(':scope > div.absolute.inset-0');
+
+  const cells = [];
+
+  slideDivs.forEach((slideDiv) => {
+    const img = slideDiv.querySelector('img');
+    if (img) {
+      // Each row is one slide containing just the image
+      cells.push([img]);
+    }
+  });
+
+  // Fallback: if structured selector missed slides, try all images directly
+  if (cells.length === 0) {
+    const allImages = element.querySelectorAll('img');
+    allImages.forEach((img) => {
+      cells.push([img]);
+    });
+  }
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'carousel-hero', cells });
+  element.replaceWith(block);
+}
diff --git a/tools/importer/parsers/columns-contact.js b/tools/importer/parsers/columns-contact.js
