@@ -0,0 +1,92 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser: cards-service
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/
+ * Description: Grid of 3 service cards, each with a circular icon, heading, and description.
+ *   Extracts icon image, h3 heading, and description paragraph from each card.
+ * Generated: 2026-05-15
+ */
+export default function parse(element, { document }) {
+  // Each card is a direct child div with class "group"
+  const cards = element.querySelectorAll(':scope > div.group');
+
+  const cells = [];
+
+  cards.forEach((card) => {
+    // Icon image: inside the circular container (rounded-full div)
+    // Source icons are inline base64 SVGs with data-icon attributes (FontAwesome).
+    // Extract icon name from the SVG to create a proper /icons/ reference for EDS.
+    const iconImg = card.querySelector('.rounded-full img, .w-20 img, [class*="rounded-full"] img');
+
+    // Heading: h3 element within the card
+    const heading = card.querySelector('h3, h2, [class*="font-heading"]');
+
+    // Description: paragraph element within the card
+    const description = card.querySelector('p, [class*="text-temple-muted"]');
+
+    // Build row: col1 = icon image, col2 = heading + description
+    const col1 = [];
+
+    // The source page may render icons as <img> with data URIs, inline <svg>, or
+    // FontAwesome <i>/<svg> elements. Try multiple strategies to find the icon.
+    const iconContainer = card.querySelector('[class*="rounded-full"], [class*="w-20"]');
+    const svgEl = iconContainer ? iconContainer.querySelector('svg') : null;
+    const imgEl = iconContainer ? iconContainer.querySelector('img') : null;
+
+    // Determine icon name from available source elements
+    let iconName = '';
+    if (svgEl) {
+      // Live page may render FontAwesome as inline SVGs with data-icon attribute
+      iconName = svgEl.getAttribute('data-icon') || '';
+    }
+    if (!iconName && imgEl) {
+      // Cached source uses <img src="data:image/svg+xml;base64,...">
+      const src = imgEl.getAttribute('src') || '';
+      if (src.startsWith('data:image/svg+xml;base64,')) {
+        try {
+          const svgText = atob(src.replace('data:image/svg+xml;base64,', ''));
+          const match = svgText.match(/data-icon="([^"]+)"/);
+          if (match) iconName = match[1];
+        } catch (e) { /* ignore decode errors */ }
+      }
+    }
+
+    // Create an img element referencing /icons/{name}.svg for AEM EDS icon system
+    if (iconName) {
+      const img = document.createElement('img');
+      img.src = `/icons/${iconName}.svg`;
+      img.alt = iconName.replace(/-/g, ' ');
+      col1.push(img);
+    } else if (imgEl) {
+      // Fallback: use the original img element as-is
+      const img = document.createElement('img');
+      const fallbackName = heading ? heading.textContent.trim().toLowerCase().replace(/\s+/g, '-') : 'icon';
+      img.src = `/icons/${fallbackName}.svg`;
+      img.alt = heading ? heading.textContent.trim() : 'icon';
+      col1.push(img);
+    } else {
+      // Last resort: create a placeholder icon from heading text
+      const fallbackName = heading ? heading.textContent.trim().toLowerCase().replace(/\s+/g, '-') : 'icon';
+      const img = document.createElement('img');
+      img.src = `/icons/${fallbackName}.svg`;
+      img.alt = heading ? heading.textContent.trim() : 'icon';
+      col1.push(img);
+    }
+
+    const col2 = [];
+    if (heading) {
+      col2.push(heading);
+    }
+    if (description) {
+      col2.push(description);
+    }
+
+    cells.push([col1, col2]);
+  });
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-service', cells });
+  element.replaceWith(block);
+}
diff --git a/tools/importer/parsers/cards-seva.js b/tools/importer/parsers/cards-seva.js
