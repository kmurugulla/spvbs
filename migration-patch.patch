+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser: cards-donation
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/
+ * Selector: section.py-12.bg-temple-light .max-w-2xl
+ * Generated: 2026-05-15
+ *
+ * Donation project card with: title (h3), description, info note,
+ * 3-column stats grid, progress bar with raised/goal amounts,
+ * two CTA buttons, and donor recognition note.
+ *
+ * The section h2 heading ("Donate to the Wedding & Event Hall Project")
+ * is default content handled by the transformer, not part of this card block.
+ * The card content starts inside the gradient/shadow container with an h3.
+ *
+ * Note: On the live page, this block's content may be dynamically rendered
+ * and not present in the initial DOM. The parser handles both the full
+ * content case (import workflow with scraped HTML) and the minimal case.
+ */
+export default function parse(element, { document }) {
+  // The element is the .max-w-2xl container. The donation card content lives
+  // inside a nested gradient/shadow container. If that container is missing
+  // (dynamic rendering), fall back to extracting from the element directly.
+  const card = element.querySelector('[class*="bg-gradient"], [class*="shadow-decorative"]') || element;
+
+  // Extract title - prefer h3 (card title inside gradient container),
+  // fall back to h2 when card content is not fully rendered
+  const title = card.querySelector('h3') || element.querySelector('h3') || card.querySelector('h2');
+
+  // Extract description - paragraph immediately after the title heading
+  let descriptionEl = null;
+  if (title && title.nextElementSibling && title.nextElementSibling.tagName === 'P') {
+    descriptionEl = title.nextElementSibling;
+  }
+  if (!descriptionEl) {
+    descriptionEl = card.querySelector('h3 + p');
+  }
+
+  // Extract info note - p.text-sm inside a bordered/backdrop container
+  // that does NOT contain .flex.justify-between (which is the progress container)
+  const borderedContainers = card.querySelectorAll(
+    'div[class*="border"][class*="backdrop-blur"], div[class*="border"][class*="bg-white"]'
+  );
+  let infoNote = null;
+  for (const container of borderedContainers) {
+    const p = container.querySelector('p[class*="text-sm"]');
+    if (p && !container.querySelector('.flex.justify-between')) {
+      infoNote = p;
+      break;
+    }
+  }
+
+  // Extract stats grid items - div.text-center children inside grid-cols-3
+  const statsGrid = card.querySelector('div[class*="grid-cols-3"]');
+  const statTexts = [];
+  if (statsGrid) {
+    const statCells = statsGrid.querySelectorAll('div.text-center');
+    statCells.forEach((cell) => {
+      const textEl = cell.querySelector('div[class*="text-sm"], span[class*="text-sm"]');
+      if (textEl) statTexts.push(textEl.textContent.trim());
+    });
+  }
+
+  // Extract progress information from the container with .flex.justify-between rows
+  // and a progress bar (rounded-full element)
+  let progressPercent = '';
+  let raisedAmount = '';
+  let goalAmount = '';
+
+  let progressContainer = null;
+  for (const div of borderedContainers) {
+    if (div.querySelector('.flex.justify-between') && div.querySelector('[class*="rounded-full"]')) {
+      progressContainer = div;
+      break;
+    }
+  }
+
+  if (progressContainer) {
+    const justifyRows = progressContainer.querySelectorAll('.flex.justify-between');
+    // First row: "Fundraising Progress" label + "16.7%" percentage
+    if (justifyRows.length >= 1) {
+      const percentSpan = justifyRows[0].querySelector('span[class*="font-bold"]');
+      if (percentSpan) progressPercent = percentSpan.textContent.trim();
+    }
+    // Second row: raised amount + goal amount
+    if (justifyRows.length >= 2) {
+      const amountDivs = justifyRows[1].querySelectorAll(':scope > div');
+      if (amountDivs.length >= 2) {
+        const raisedDiv = amountDivs[0].querySelector('div[class*="font-bold"]');
+        const goalDiv = amountDivs[1].querySelector('div[class*="font-bold"]');
+        if (raisedDiv) raisedAmount = raisedDiv.textContent.trim();
+        if (goalDiv) goalAmount = goalDiv.textContent.trim();
+      }
+    }
+  }
+
+  // Extract CTA links from the space-y container
+  const ctaContainer = card.querySelector('div[class*="space-y"]');
+  const ctaLinks = ctaContainer
+    ? Array.from(ctaContainer.querySelectorAll('a'))
+    : Array.from(card.querySelectorAll('a[href*="donate"], a[href*="project"]'));
+
+  // Extract donor recognition note - last p.text-sm that is NOT the info note
+  const allSmallPs = card.querySelectorAll('p[class*="text-sm"]');
+  let donorNote = null;
+  if (allSmallPs.length > 0) {
+    const lastP = allSmallPs[allSmallPs.length - 1];
+    if (lastP !== infoNote) donorNote = lastP;
+  }
+
+  // Build content cell following cards library pattern: image | title + description
+  // For donation variant: single card row with structured text content (no image column,
+  // since the icons are decorative inline SVGs that don't translate to meaningful images)
+  const contentCell = [];
+
+  if (title) {
+    contentCell.push(title);
+  }
+
+  if (descriptionEl) {
+    contentCell.push(descriptionEl);
+  }
+
+  // Info note as emphasized paragraph
+  if (infoNote) {
+    const em = document.createElement('em');
+    em.textContent = infoNote.textContent.trim();
+    contentCell.push(em);
+  }
+
+  // Stats as an unordered list
+  if (statTexts.length > 0) {
+    const ul = document.createElement('ul');
+    statTexts.forEach((text) => {
+      const li = document.createElement('li');
+      li.textContent = text;
+      ul.appendChild(li);
+    });
+    contentCell.push(ul);
+  }
+
+  // Progress information as a paragraph
+  if (progressPercent || raisedAmount || goalAmount) {
+    const p = document.createElement('p');
+    const parts = [];
+    if (progressPercent) parts.push('Progress: ' + progressPercent);
+    if (raisedAmount) parts.push('Raised: ' + raisedAmount);
+    if (goalAmount) parts.push('Goal: ' + goalAmount);
+    p.textContent = parts.join(' | ');
+    contentCell.push(p);
+  }
+
+  // CTA buttons as links
+  ctaLinks.forEach((link) => {
+    const a = document.createElement('a');
+    a.href = link.href || link.getAttribute('href');
+    a.textContent = link.textContent.trim();
+    contentCell.push(a);
+  });
+
+  // Donor recognition note
+  if (donorNote) {
+    const p = document.createElement('p');
+    p.textContent = donorNote.textContent.trim();
+    contentCell.push(p);
+  }
+
+  // If no content was found at all, do not create an empty block
+  if (contentCell.length === 0) {
+    return;
+  }
+
+  // Build cells: single row with content
+  const cells = [contentCell];
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-donation', cells });
+  element.replaceWith(block);
+}
