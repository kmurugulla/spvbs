@@ -0,0 +1,75 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for table-donor variant.
+ * Base block: table
+ * Source: https://www.spvbstemple.org/donors
+ * Generated: 2026-05-15
+ *
+ * Extracts a 4-column donation records table with header row and data rows.
+ * Columns: Name, Cause, Amount, Notes
+ *
+ * Target structure (from authoring analysis):
+ *   Row 0: Header row — [Name, Cause, Amount, Notes]
+ *   Rows 1..N: Data rows — [donor name, cause category, amount in INR, notes text]
+ *
+ * Validated selectors against cleaned.html:
+ *   - Table: table.min-w-full (the HTML <table> element)
+ *   - Header row: thead tr
+ *   - Header cells: thead tr th (4 cells: Name, Cause, Amount, Notes)
+ *   - Data rows: tbody tr
+ *   - Data cells: td (4 per row, with classes px-4, py-3)
+ *
+ * The element passed to parse() is expected to be:
+ *   - The section or wrapper containing the table (section.mb-16, div.w-full, or div.overflow-x-auto)
+ *   - Or the <table> element directly
+ *
+ * Handles variations:
+ *   - Table may be nested inside wrapper divs
+ *   - Some Notes cells contain em-dash (—) for empty, some have text
+ *   - Amount cells have right-aligned text with rupee symbol
+ *   - Variable number of data rows
+ */
+export default function parse(element, { document }) {
+  // Find the table element — it may be the element itself or nested within it
+  const table = element.tagName === 'TABLE'
+    ? element
+    : element.querySelector('table');
+
+  if (!table) {
+    // Fallback: if no table found, create an empty block
+    const block = WebImporter.Blocks.createBlock(document, { name: 'table-donor', cells: [] });
+    element.replaceWith(block);
+    return;
+  }
+
+  const cells = [];
+
+  // Extract header row from thead
+  const thead = table.querySelector('thead');
+  if (thead) {
+    const headerRow = thead.querySelector('tr');
+    if (headerRow) {
+      const headerCells = Array.from(headerRow.querySelectorAll('th'));
+      // Build header row as array of text strings
+      const headerData = headerCells.map((th) => th.textContent.trim());
+      cells.push(headerData);
+    }
+  }
+
+  // Extract data rows from tbody
+  const tbody = table.querySelector('tbody');
+  if (tbody) {
+    const dataRows = Array.from(tbody.querySelectorAll('tr'));
+    dataRows.forEach((tr) => {
+      const tds = Array.from(tr.querySelectorAll('td'));
+      // Each row: [Name, Cause, Amount, Notes]
+      const rowData = tds.map((td) => td.textContent.trim());
+      cells.push(rowData);
+    });
+  }
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'table-donor', cells });
+  element.replaceWith(block);
+}
