+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser: cards-project
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/projects
+ * Description: Grid of completed project cards (no images). Each card has a title (h3),
+ *   funding amount (bold green paragraph), description paragraph, benefits list (ul),
+ *   and a "Completed" status indicator. Single-column cards variant (1 cell per row).
+ * Generated: 2026-05-15
+ *
+ * Source structure:
+ *   div.grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-6 (container)
+ *     > div.bg-white.rounded-xl.shadow-decorative (card wrapper)
+ *       > div.p-4 (inner padding)
+ *         > h3.text-xl.font-heading.text-temple-primary (project title)
+ *         > p.font-bold.text-green-700 (amount raised)
+ *         > p.text-temple-text.line-clamp-2 (description)
+ *         > ul.mt-2 (benefits list)
+ *         > div.mt-4.flex.items-center (completed status indicator)
+ */
+export default function parse(element, { document }) {
+  // Select all card wrappers — direct children with card styling
+  // Source cards have classes: bg-white rounded-xl shadow-decorative
+  let cards = element.querySelectorAll(':scope > div.rounded-xl');
+
+  // Fallback: try broader selectors if rounded-xl cards not found
+  if (!cards.length) {
+    cards = element.querySelectorAll(':scope > div.bg-white');
+  }
+
+  // Last resort: try any direct child div
+  if (!cards.length) {
+    cards = element.querySelectorAll(':scope > div');
+  }
+
+  const cells = [];
+
+  cards.forEach((card) => {
+    // Project title: h3 heading
+    const heading = card.querySelector('h3, h2, h4, [class*="font-heading"]');
+
+    // Amount raised: bold green paragraph (e.g., "Rs.30 Lakh Raised")
+    const amount = card.querySelector('p.font-bold, p.text-green-700, p[class*="green"]');
+
+    // Description: text paragraph (not the amount paragraph)
+    const description = card.querySelector('p.text-temple-text, p.line-clamp-2');
+
+    // Benefits list
+    const benefitsList = card.querySelector('ul');
+
+    // Build single-column cell: heading + amount + description + benefits
+    const cellContent = [];
+
+    if (heading) {
+      cellContent.push(heading);
+    }
+    if (amount) {
+      cellContent.push(amount);
+    }
+    if (description) {
+      cellContent.push(description);
+    }
+    if (benefitsList) {
+      cellContent.push(benefitsList);
+    }
+
+    // Only add row if we have meaningful content
+    if (cellContent.length > 0) {
+      cells.push([cellContent]);
+    }
+  });
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-project', cells });
+  element.replaceWith(block);
+}
