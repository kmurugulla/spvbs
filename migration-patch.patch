+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for cards-teaching variant.
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/about
+ * Generated: 2026-05-15
+ *
+ * Extracts a grid of teaching/topic cards, each with an icon, heading,
+ * and description paragraph. Produces one row per card with:
+ *   col1 = icon image
+ *   col2 = heading + description
+ *
+ * Source structure:
+ *   div.grid (container)
+ *     > div.relative.p-8 (card wrapper)
+ *       > div.flex.flex-col (inner layout)
+ *         > div.text-4xl > img (icon)
+ *         > h3 (heading)
+ *         > p  (description)
+ */
+export default function parse(element, { document }) {
+  // Select all card wrappers — direct children of the grid that are bordered card containers
+  const cards = element.querySelectorAll(':scope > div.relative');
+
+  // Fallback: if no .relative divs, try any direct child div
+  const cardElements = cards.length > 0
+    ? cards
+    : element.querySelectorAll(':scope > div');
+
+  const cells = [];
+
+  cardElements.forEach((card) => {
+    // Extract icon image from the icon container
+    const icon = card.querySelector('div.text-4xl img, div.text-temple-gold img, img[src^="data:image/svg"]');
+
+    // Extract heading — h3 is primary, fall back to h2, h4
+    const heading = card.querySelector('h3, h2, h4');
+
+    // Extract description paragraph(s) from the card content area
+    // Use a Set-based approach to avoid duplicates when multiple selectors match the same element
+    const descSet = new Set();
+    card.querySelectorAll('p.text-gray-300, p.leading-relaxed, div.flex.flex-col > p').forEach((p) => descSet.add(p));
+    const descriptions = Array.from(descSet);
+
+    // Build col1: icon image
+    const col1 = [];
+    if (icon) {
+      col1.push(icon);
+    }
+
+    // Build col2: heading + description(s)
+    const col2 = [];
+    if (heading) {
+      col2.push(heading);
+    }
+    descriptions.forEach((desc) => {
+      col2.push(desc);
+    });
+
+    // Only add row if we have meaningful content
+    if (col1.length > 0 || col2.length > 0) {
+      cells.push([
+        col1.length === 1 ? col1[0] : col1,
+        col2,
+      ]);
+    }
+  });
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-teaching', cells });
+  element.replaceWith(block);
+}
diff --git a/tools/importer/parsers/cards-video.js b/tools/importer/parsers/cards-video.js
new file mode 100644
index 0000000..b13a94f
--- /dev/null
+++ b/tools/importer/parsers/cards-video.js
@@ -0,0 +1,92 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for cards-video variant.
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/gallery
+ * Generated: 2026-05-15
+ *
+ * Extracts a grid of video thumbnail cards from the gallery page.
+ * Each card has:
+ *   - A YouTube thumbnail image (inside div.aspect-video)
+ *   - A video title (h3.font-heading)
+ *
+ * The YouTube video ID is extracted from the thumbnail URL to construct
+ * a YouTube watch link, placed alongside the title in col2.
+ *
+ * Target structure (from block library):
+ *   2 columns per row: col1 = thumbnail image, col2 = title heading + YouTube link
+ *   One row per video card.
+ *
+ * Validated selectors against source.html (cleaned.html):
+ *   - Cards: :scope > div (direct children of the grid element)
+ *   - Thumbnail: div.aspect-video img.object-cover (first img in aspect-video container)
+ *   - Title: h3.font-heading, h3 (fallback)
+ *   - Play overlay: div.absolute.inset-0 (decorative, skipped)
+ */
+export default function parse(element, { document }) {
+  // Select all card containers — direct children of the grid element
+  const cards = element.querySelectorAll(':scope > div');
+
+  const cells = [];
+
+  cards.forEach((card) => {
+    // Col 1: Thumbnail image
+    // Select the first img inside the aspect-video container (the actual thumbnail),
+    // not the play icon overlay which is a base64 SVG inside div.absolute
+    const aspectContainer = card.querySelector('div.aspect-video, div[class*="aspect-video"]');
+    let thumbnailImg = null;
+    if (aspectContainer) {
+      // Get the first img that is a direct child or inside the container but NOT inside the overlay
+      thumbnailImg = aspectContainer.querySelector(':scope > img, :scope > img.object-cover');
+      if (!thumbnailImg) {
+        // Fallback: get first img with object-cover class
+        thumbnailImg = aspectContainer.querySelector('img.object-cover');
+      }
+      if (!thumbnailImg) {
+        // Broader fallback: first img that is not a data:image SVG play icon
+        const imgs = aspectContainer.querySelectorAll('img');
+        for (const img of imgs) {
+          if (!img.src.startsWith('data:image/svg+xml')) {
+            thumbnailImg = img;
+            break;
+          }
+        }
+      }
+    }
+
+    // Col 2: Video title + YouTube link
+    const heading = card.querySelector('h3.font-heading, h3');
+
+    // Extract YouTube video ID from the thumbnail URL to build a watch link
+    // Thumbnail URLs follow: ...i.ytimg.com/vi/{VIDEO_ID}/hqdefault.jpg...
+    let youtubeLink = null;
+    if (thumbnailImg && thumbnailImg.src) {
+      const srcDecoded = decodeURIComponent(thumbnailImg.src);
+      const videoIdMatch = srcDecoded.match(/\/vi\/([^/]+)\//);
+      if (videoIdMatch && videoIdMatch[1]) {
+        const videoId = videoIdMatch[1];
+        youtubeLink = document.createElement('a');
+        youtubeLink.href = `https://www.youtube.com/watch?v=${videoId}`;
+        youtubeLink.textContent = `https://www.youtube.com/watch?v=${videoId}`;
+      }
+    }
+
+    // Build col1 — thumbnail image
+    const col1 = thumbnailImg || '';
+
+    // Build col2 — heading and YouTube link
+    const col2 = [];
+    if (heading) col2.push(heading);
+    if (youtubeLink) col2.push(youtubeLink);
+
+    // Only add row if we have meaningful content
+    if (thumbnailImg || heading) {
+      cells.push([col1, col2]);
+    }
+  });
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-video', cells });
+  element.replaceWith(block);
+}
