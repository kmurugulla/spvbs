+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Parser for cards-event-detail variant.
+ * Base block: cards
+ * Source: https://www.spvbstemple.org/events
+ * Generated: 2026-05-15
+ *
+ * Extracts vertically stacked event detail cards from the events page.
+ * Each event section contains:
+ *   - A category heading (h2)
+ *   - A card with: event name (h3), "Annual Event" badge (span), description (p/div),
+ *     and an optional "View Details" CTA button
+ *
+ * Target structure (from block library — Cards no images):
+ *   1 column per row: heading + paragraph(s)
+ *   One row per event card.
+ *
+ * Validated selectors against cleaned.html:
+ *   - Event sections: div.space-y-16 > section.space-y-6
+ *   - Card container: div.bg-white.rounded-xl.shadow-decorative
+ *   - Event name heading: h3 (inside card)
+ *   - Badge: span.inline-block (text "Annual Event")
+ *   - Short description: p.text-temple-text (first p in card)
+ *   - Extended description: div.text-temple-text > p (rich text with bold, br)
+ *   - CTA button: button (with "View Details" text)
+ *
+ * Variations handled:
+ *   - Cards with only a short description (no extended text, no CTA)
+ *   - Cards with extended description and CTA button
+ *   - Badge text may vary
+ */
+export default function parse(element, { document }) {
+  // The element is expected to be the container holding all event sections
+  // (div.space-y-16 or similar). Each section.space-y-6 holds one event.
+  const sections = element.querySelectorAll('section, :scope > div > section');
+
+  // Fallback: if no sections found, treat direct child divs as card containers
+  const eventContainers = sections.length > 0
+    ? sections
+    : element.querySelectorAll(':scope > div');
+
+  const cells = [];
+
+  eventContainers.forEach((section) => {
+    // Find the card container within this section
+    const card = section.querySelector('div.bg-white, div.rounded-xl, div.shadow-decorative')
+      || section;
+
+    // Event name heading (h3 inside the card)
+    const heading = card.querySelector('h3, h2');
+
+    // Badge text (e.g., "Annual Event")
+    const badge = card.querySelector('span.inline-block, span[class*="rounded-full"], span[class*="bg-yellow"]');
+
+    // Short description — first direct <p> in the card
+    const shortDesc = card.querySelector(':scope > p, :scope > div > p.text-temple-text');
+
+    // Extended description — a div containing rich text paragraphs
+    const extendedDescDiv = card.querySelector(':scope > div.text-temple-text');
+
+    // CTA button — "View Details" or similar
+    const ctaButton = card.querySelector('button, a.bg-temple-primary, a[class*="btn"]');
+
+    // Build single-column content cell: heading, badge, description(s), CTA
+    const contentCell = [];
+
+    if (heading) {
+      contentCell.push(heading);
+    }
+
+    // Add badge as an emphasized paragraph
+    if (badge) {
+      const badgeP = document.createElement('p');
+      const em = document.createElement('em');
+      em.textContent = badge.textContent.trim();
+      badgeP.appendChild(em);
+      contentCell.push(badgeP);
+    }
+
+    // Add short description
+    if (shortDesc) {
+      contentCell.push(shortDesc);
+    }
+
+    // Add extended description content (rich text paragraphs)
+    if (extendedDescDiv) {
+      const extParagraphs = extendedDescDiv.querySelectorAll('p');
+      extParagraphs.forEach((p) => {
+        contentCell.push(p);
+      });
+    }
+
+    // Add CTA as a link if present
+    if (ctaButton) {
+      const ctaP = document.createElement('p');
+      const link = document.createElement('a');
+      link.href = ctaButton.getAttribute('href') || '#';
+      link.textContent = ctaButton.textContent.trim() || 'View Details';
+      const strong = document.createElement('strong');
+      strong.appendChild(link);
+      ctaP.appendChild(strong);
+      contentCell.push(ctaP);
+    }
+
+    // Only add row if we have content
+    if (contentCell.length > 0) {
+      cells.push([contentCell]);
+    }
+  });
+
+  const block = WebImporter.Blocks.createBlock(document, { name: 'cards-event-detail', cells });
+  element.replaceWith(block);
+}
