diff --git a/tools/importer/transformers/spvbs-cleanup.js b/tools/importer/transformers/spvbs-cleanup.js
new file mode 100644
index 0000000..36b5f57
--- /dev/null
+++ b/tools/importer/transformers/spvbs-cleanup.js
@@ -0,0 +1,32 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Transformer: spvbs cleanup.
+ * Removes non-authorable site-wide elements from Sri Veerabrahmendra Swami Temple pages.
+ * All selectors verified against captured DOM in migration-work/cleaned.html.
+ */
+const TransformHook = { beforeTransform: 'beforeTransform', afterTransform: 'afterTransform' };
+
+export default function transform(hookName, element, payload) {
+  if (hookName === TransformHook.beforeTransform) {
+    // No cookie banners, modals, or overlays found in captured DOM.
+    // No elements blocking block parsing detected.
+  }
+
+  if (hookName === TransformHook.afterTransform) {
+    // Remove non-authorable site shell elements.
+    // header.fixed — fixed navigation bar (cleaned.html line 6)
+    // footer.bg-temple-dark — site footer with contact, links, schedule (cleaned.html line 370)
+    // next-route-announcer — Next.js route announcer element (cleaned.html line 497)
+    // link — stylesheet link elements (safe to remove)
+    // noscript — noscript fallback elements (safe to remove)
+    WebImporter.DOMUtils.remove(element, [
+      'header',
+      'footer',
+      'next-route-announcer',
+      'link',
+      'noscript',
+    ]);
+  }
+}
diff --git a/tools/importer/transformers/spvbs-sections.js b/tools/importer/transformers/spvbs-sections.js
new file mode 100644
index 0000000..d5f038e
--- /dev/null
+++ b/tools/importer/transformers/spvbs-sections.js
@@ -0,0 +1,52 @@
+/* eslint-disable */
+/* global WebImporter */
+
+/**
+ * Transformer: spvbs sections.
+ * Inserts section breaks (<hr>) and Section Metadata blocks based on template sections
+ * for Sri Veerabrahmendra Swami Temple pages.
+ * All selectors verified against captured DOM in migration-work/cleaned.html.
+ *
+ * Section selectors from page-templates.json (verified in cleaned.html):
+ *   section-1: .min-h-screen > div.relative.w-full (hero carousel, line 64)
+ *   section-2: div.bg-temple-light.py-16.md\:py-24 (temple intro, line 103) — style: "light"
+ *   section-3: section.py-12.bg-temple-light (donation project, line 143) — style: "light"
+ *   section-4: div.py-20.bg-white.relative (temple services, line 211)
+ *   section-5: div.bg-temple-dark.text-white.py-20 (upcoming events, line 262) — style: "dark"
+ *   section-6: div.bg-white.py-20.relative.overflow-hidden (join community, line 313)
+ *   section-7: section.faq-section (FAQ, line 335)
+ */
+const TransformHook = { beforeTransform: 'beforeTransform', afterTransform: 'afterTransform' };
+
+export default function transform(hookName, element, payload) {
+  if (hookName === TransformHook.afterTransform) {
+    const { document } = element.ownerDocument ? { document: element.ownerDocument } : { document: element.getRootNode() };
+    const template = payload && payload.template;
+    if (!template || !template.sections || template.sections.length < 2) return;
+
+    const sections = template.sections;
+
+    // Process sections in reverse order to avoid shifting DOM positions.
+    for (let i = sections.length - 1; i >= 0; i--) {
+      const section = sections[i];
+      const sectionEl = element.querySelector(section.selector);
+
+      if (!sectionEl) continue;
+
+      // Add Section Metadata block after the section element when it has a style.
+      if (section.style) {
+        const metadataBlock = WebImporter.Blocks.createBlock(document, {
+          name: 'Section Metadata',
+          cells: { style: section.style },
+        });
+        sectionEl.after(metadataBlock);
+      }
+
+      // Insert <hr> before each section except the first to create section breaks.
+      if (i > 0) {
+        const hr = document.createElement('hr');
+        sectionEl.before(hr);
+      }
+    }
+  }
+}
